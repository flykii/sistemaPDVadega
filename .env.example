# =============================================================================
# PDV ENTERPRISE — Configuração de Ambiente (.env)
# =============================================================================

# Modo de Desenvolvimento (True) ou Produção (False)
DEBUG=True

# Chave Secreta da Aplicação (Gerar uma chave forte em produção)
SECRET_KEY=django-insecure-pdv-key-change-in-production-antigravity

# Hosts permitidos separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuração do Banco de Dados (Deixe em branco para usar SQLite local)
DB_ENGINE=django.db.backends.sqlite3
# Para PostgreSQL em produção:
# DB_ENGINE=django.db.backends.postgresql
# POSTGRES_DB=pdv_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=sua_senha_forte_aqui
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Configurações de Segurança e SSL (Ativar apenas em produção com HTTPS)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Nível de Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO
